# Required for Gemini document extraction / richer agent drafting.
# The prototype falls back safely when this is missing.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# Optional Neo4j graph. The core relational pipeline still runs if Neo4j is offline.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password_here

DATABASE_URL=sqlite:///./roj_guard.db
BACKEND_URL=http://127.0.0.1:8000
APP_TIMEZONE=Asia/Kolkata

# Approved escalation execution. Default "outbox" writes a safe local email
# artifact into demo_outbox/. Use "smtp" only with a controlled test inbox.
DEMO_EMAIL_MODE=outbox
DEMO_OUTBOX_DIR=demo_outbox
DEMO_EXECUTION_DIR=demo_executions

# Only needed when DEMO_EMAIL_MODE=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true

# Render/Docker can reset the deterministic demo dataset at service startup.
STARTUP_SEED=false
